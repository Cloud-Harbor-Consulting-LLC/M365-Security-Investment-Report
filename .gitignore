# Generated reports and snapshots -- these contain tenant data and must never be committed.
out/
output/
*.snapshot.json
M365-Security-Investment-*.html
M365-Security-Investment-*.json
M365-Security-Investment-*.csv

# Engagement-specific configuration and negotiated pricing
config/chsi-config.json
config/*-pricing.json
config/*-rates.json

# App build artefacts
app/node_modules/
app/dist/
# Synced from the PowerShell module by scripts/sync-assets.mjs -- one canonical copy of
# the font bytes lives in the module, not two in git.
app/src/assets/fonts/

# Test output
testresults.xml
coverage.xml

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Tenant snapshots. These carry a real tenant's id, verified domains, user principal
# names, sign-in dates and licence counts. This repository is public, and `git add -A`
# would sweep one in without comment. Fixtures under tests/fixtures are synthetic and
# deliberately still tracked.
*snapshot*.json
!tests/fixtures/*.json
!app/**/fixtures/*.json
